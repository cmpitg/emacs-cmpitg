# -*- mode: snippet -*-
# name: flake-dev-shell
# key: -flake-dev-shell
# --
{
  description = "$1";

  inputs = {
    nixpkgs.url = "nixpkgs/nixos-25.11";
    nixpkgs-unstable.url = "nixpkgs/nixos-unstable";

    flake-parts.url = "github:hercules-ci/flake-parts";
  };

  outputs = inputs@{ self, nixpkgs, nixpkgs-unstable, flake-parts, ... }:
    let
      createDevShell = { inputs }: flake-parts.lib.mkFlake { inherit inputs; }
        (top@{ ... }: {
          systems = [ ${3:"x86_64-linux" "aarch64-linux" "aarch64-darwin"} ];
          perSystem = { system, ... }: let
            pkgs = import nixpkgs { inherit system; config = { allowUnfree = true; }; };
          in {
            # Development shell
            devShells.default = pkgs.mkShell {
              buildInputs = with pkgs; [
                ${4:hello}
              ];
            };
          };
        });
    in createDevShell { inherit inputs; };
}
